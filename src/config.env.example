# Clinical Automata — site configuration.
#
# Copy this file to `src/config.env` (git-ignored) and replace every placeholder
# with your own values:
#
#     cp src/config.env.example src/config.env
#
# Read by: clinical-automata-backend/prepare.py, the web UI backend (FastAPI),
# the web UI frontend (Vite, VITE_* keys only) and clinical-automata-webui/scripts/*.sh.
# Plain KEY=VALUE lines; no spaces around `=`; quote values that contain spaces.
# A real environment variable with the same name overrides the value here.

# --- data (agent harness) ----------------------------------------------------
# Root folder holding one sub-folder per dataset (see DATA_DIR in prepare.py).
DATA_ROOT=/path/to/your/datasets
# Writable folder for downloaded weights, cached features, intermediate files.
EXT_DATA_ROOT=/path/to/your/external_data

# --- web UI: access & signing ------------------------------------------------
# Long random string that signs login cookies and download links, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start in real mode while this is still the placeholder.
CAWEBUI_secret_key=CHANGE_ME_SECRET_KEY
# Fallback site passcode, used only when webui/access_codes.txt is absent.
CAWEBUI_access_code=CHANGE_ME_ACCESS_CODE

# --- web UI: email -----------------------------------------------------------
# Receives a notification whenever a session starts or is interrupted.
CAWEBUI_owner_email=your-email@example.com
CAWEBUI_smtp_host=smtp.example.com
CAWEBUI_smtp_port=587
CAWEBUI_smtp_user=your-email@example.com
# Leave empty to only log emails instead of sending them.
CAWEBUI_smtp_password=
# Optional: keep a copy of sent mail via IMAP (empty disables).
CAWEBUI_imap_host=

# --- web UI: public deployment -----------------------------------------------
# Public hostname of the demo (Cloudflare named tunnel), without https://.
DEMO_HOSTNAME=demo.example.com
# Used to build signed download links in completion emails.
CAWEBUI_public_url=https://demo.example.com
# Name of the Cloudflare named tunnel and its config file.
CF_TUNNEL_NAME=your-tunnel-name
CF_CONFIG=/path/to/.cloudflared/config.yml

# --- web UI: frontend --------------------------------------------------------
# Contact address shown to users in the UI (all languages).
VITE_CONTACT_EMAIL=your-email@example.com
